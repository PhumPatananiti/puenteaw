# Copy this file to .env and paste your Gemini key. With no key at all the app
# runs on a built-in sample trip so you can still try the interface.

# google | anthropic | mock   (auto = Gemini if GOOGLE_API_KEY is set, else Claude, else mock)
LLM_PROVIDER=google

# Google Gemini — get a key at aistudio.google.com
GOOGLE_API_KEY=
# Flash Lite has a large free daily quota; gemini-3.5-flash plans a little more carefully
GOOGLE_MODEL=gemini-3.5-flash-lite

# Optional alternative planner: Claude (console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_FALLBACKS=default

# Postgres for saved, shareable trips. Leave empty to keep trips in the browser only.
# On Railway set it to the reference variable ${{Postgres.DATABASE_URL}}.
DATABASE_URL=
# auto = TLS except for localhost and Railway's private network; true / false to force
DATABASE_SSL=auto

# Currency the planner prices things in when the description does not say
DEFAULT_CURRENCY=THB

PORT=4100
